APP_ENV=local
APP_NAME=SAS-FRAUD
APP_HOST=127.0.0.1
APP_PORT=8000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sas_fraud

LOG_LEVEL=INFO

# SAS Message Test Console
SAS_DECISION_URL=https://banking-fraud.ingress-nginx.sas.env/detection/decision/execute
SAS_REQUEST_TIMEOUT_SECONDS=30
SAS_TLS_VERIFY=false
# Set this to the internal CA file when one is available.
SAS_CA_BUNDLE=

# Visual Investigator bridge (app/backend/vi_bridge)
VI_BASE_URL=https://viya.sas.env
VI_TLS_VERIFY=false
VI_USERNAME=
VI_PASSWORD=
VI_DOMAIN_ID=svidomain
VI_ALERT_ORIGIN_CODE=AT
VI_REQUEST_TIMEOUT_SECONDS=30
